rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
// Only people listed in the "staff" collection can read or upload anything.
service cloud.firestore {
  match /databases/{db}/documents {
    function isStaff() {
      return request.auth != null && exists(/databases/$(db)/documents/staff/$(request.auth.token.email));
    }
    function isAdmin() {
      return isStaff() && get(/databases/$(db)/documents/staff/$(request.auth.token.email)).data.role == 'admin';
    }
    match /staff/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;  // check your own entry at sign-in
      allow read, write: if isAdmin();                                          // only admins see or change the list
    }
    match /inspections/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.resource.data.uploadedBy == request.auth.token.email;
      // admins can link an inspection to a culvert in the list (only these fields)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['culvertRef', 'linkedAt', 'linkedBy']);
      allow delete: if isAdmin();
    }
    match /culverts/{id} {
      allow read: if isStaff();   // phones download the list for suggestions
      allow write: if isAdmin();
    }
  }
}
